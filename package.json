{
  "name": "kandidu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "24.21.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -b",
    "architecture": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "test:e2e": "playwright test",
    "ship": "node scripts/ship.mjs",
    "models:check": "node scripts/check-model-routing.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm architecture && pnpm test && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "docxtemplater": "3.71.1",
    "fflate": "0.8.3",
    "html-entities": "2.6.0",
    "idb": "8.0.4",
    "pizzip": "3.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "dependency-cruiser": "18.6.0",
    "fake-indexeddb": "6.2.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
